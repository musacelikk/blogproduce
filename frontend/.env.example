# Backend API base URL. Required — the app refuses to start in production
# without it rather than silently calling localhost.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Host serving uploaded images, when it is not a plain S3 or CloudFront URL
# (a custom domain matching the backend's AWS_S3_PUBLIC_URL). next/image rejects
# any host not allow-listed in next.config.js, so an uploaded image on an
# unlisted domain fails to render entirely.
# NEXT_PUBLIC_ASSET_HOST=cdn.example.com
