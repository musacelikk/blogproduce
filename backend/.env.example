# Copy to .env and fill in. Values marked REQUIRED must be set or the app will
# not start (or the feature they gate will be unavailable).

# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Comma-separated list of exact origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# ── Database (REQUIRED) ─────────────────────────────────────────────────
# Either DATABASE_URL, or the DB_* parts below.
DATABASE_URL=postgresql://user:password@localhost:5432/blogproduce
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_NAME=blogproduce

# Schema migrations run automatically at every boot (see
# src/database/schema-migrator.service.ts). Set to false only if you manage the
# schema yourself — a missing column breaks every query against that table.
AUTO_MIGRATE=true

# ── Auth (REQUIRED) ─────────────────────────────────────────────────────
# Must be at least 32 characters. The app refuses to start without it.
JWT_SECRET=
API_KEY_ENCRYPTION_KEY=

# ── AI providers ────────────────────────────────────────────────────────
# REQUIRED — every quality tier currently runs on OpenAI.
OPENAI_API_KEY=
OPENAI_MAX_TOKENS=16000

# Optional. Setting this enables the Anthropic provider; without it any
# Claude-backed tier silently degrades to an OpenAI model.
ANTHROPIC_API_KEY=

# Which model each quality tier runs on. Defaults are OpenAI-only
# (gpt-4o-mini / gpt-4o / gpt-4.1). Once ANTHROPIC_API_KEY is set, moving a tier
# to Claude is just a config change — pricing and cost projections follow the
# model automatically.
#   TIER_MODEL_PRO=claude-sonnet-5
#   TIER_MODEL_PREMIUM=claude-opus-5
# TIER_MODEL_STANDARD=
# TIER_MODEL_PRO=
# TIER_MODEL_PREMIUM=

# ── Billing ─────────────────────────────────────────────────────────────
# We charge in TRY but our providers bill in USD. This rate converts provider
# cost for margin reporting only; it never rewrites what a customer was charged.
# Keep it current — a stale rate makes every margin in the admin panel wrong.
USD_TRY_RATE=42

# Bank transfer (havale/EFT) collection details. All three must be set or the
# payment flow refuses to open orders rather than quoting an incomplete IBAN.
BANK_NAME=
BANK_ACCOUNT_HOLDER=
BANK_IBAN=

# ── Admin seed user ─────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ── AWS (asset storage + generation queue) ──────────────────────────────
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
# Public base URL for uploaded assets — a CloudFront distribution or custom
# domain. Leave blank to serve straight from the S3 endpoint.
AWS_S3_PUBLIC_URL=
AWS_S3_FORCE_PATH_STYLE=false

# Per-object ACL. Leave blank for buckets created after April 2023 (ACLs are
# disabled there by default and sending one fails the upload); grant public read
# with a bucket policy instead. Set to public-read only for an older bucket that
# still relies on object ACLs.
AWS_S3_ACL=

# Generation is asynchronous; the worker process consumes these queues.
SQS_GENERATE_POST_QUEUE_URL=
SQS_GENERATE_POST_QUEUE_DLQ=
SQS_PUBLISH_POST_QUEUE_URL=
WORKER_JOB_TIMEOUT_MS=600000

# ── Images ──────────────────────────────────────────────────────────────
UNSPLASH_APP_ID=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# ── Uploads ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif
